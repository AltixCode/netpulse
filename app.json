{
  "expo": {
    "name": "NetPulse",
    "slug": "netpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "netpulse",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altixcode.netpulse",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "NetPulse needs local network access to scan subnet devices and measure latency."
      }
    },
    "android": {
      "package": "com.altixcode.netpulse",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-ios-scene-lifecycle.js"
    ]
  }
}
